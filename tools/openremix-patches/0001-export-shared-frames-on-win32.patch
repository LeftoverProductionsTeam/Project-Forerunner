Subject: Export OpenRemix editor shared frames on Windows
Upstream: https://github.com/TheGreatHMMMM/OpenRemix
Base-commit: 13c3a1001be4d5eb40a8037c136ca6efca8461eb
Upstream-License: Apache-2.0

Reuse the Linux headless frame allocator and render synchronization. Keep
the Linux file-descriptor ABI and add a separate Windows export with
caller-owned opaque Win32 NT memory and semaphore handles.

diff --git a/public/include/remix/remix_editor_ext.h b/public/include/remix/remix_editor_ext.h
--- a/public/include/remix/remix_editor_ext.h
+++ b/public/include/remix/remix_editor_ext.h
@@ -1,4 +1,4 @@
-// Optional Linux editor ABI; the Remix 0.1003 table is unchanged.
+// Optional editor ABI; the Remix 0.1003 table is unchanged.
 #pragma once
 #include "remix_c.h"
 #define REMIXAPI_STRUCT_TYPE_EDITOR_STARTUP_EXT ((remixapi_StructType)0x7fff1010)
@@ -21,10 +21,25 @@
   uint8_t device_uuid[16];
   int memory_fd, ready_fd, released_fd;
 } remixapi_EditorSharedFrame;
+#if defined(_WIN32)
+// Version 1 mirrors the Linux frame description. The three output handles
+// are opaque Win32 NT handles owned by the caller, which must CloseHandle
+// each one after import (or if import fails). The image and semaphore usage
+// and the EXTERNAL ownership protocol are the same as the Linux contract.
+typedef struct remixapi_EditorSharedFrameWin32 {
+  uint32_t version, width, height, memory_type;
+  uint64_t allocation_size;
+  uint8_t device_uuid[16];
+  void *memory_handle, *ready_handle, *released_handle;
+} remixapi_EditorSharedFrameWin32;
+#endif
 #ifdef __cplusplus
 extern "C" {
 #endif
 REMIXAPI int REMIXAPI_CALL remixapi_EditorConfigureSharedFrame(remixapi_EditorSharedFrame *frame);
+#if defined(_WIN32)
+REMIXAPI int REMIXAPI_CALL remixapi_EditorConfigureSharedFrameWin32(remixapi_EditorSharedFrameWin32 *frame);
+#endif
 #ifdef __cplusplus
 }
 #endif
